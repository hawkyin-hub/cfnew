install\", \"-q\", \"--target\", LIBS_DIR, \"-U\", \"huggingface_hub<2.0\"],\n        check=True,\n    )\n    open(core_flag, \"w\").close()\n\n# 2b. comfy-aimdo（用 pkg_installed 判断，避免重复下载）\nif not pkg_installed(\"comfy-aimdo\"):\n    print(\"[INFO] Installing comfy-aimdo ...\")\n    subprocess.run(\n        [\"pip\", \"install\", \"-q\", \"--target\", LIBS_DIR, \"comfy-aimdo\"],\n        check=True,\n    )\nelse:\n    print(\"[INFO] comfy-aimdo already present, skip.\")\n\n# 3. GGUF 节点（仓库 + 依赖）\ngguf_node_dir = os.path.join(WORK_DIR, \"custom_nodes/ComfyUI-GGUF\")\ngguf_flag = os.path.join(FLAG_DIR, \"gguf_deps.done\")\n\nif not os.path.exists(gguf_node_dir):\n    subprocess.run(\n        [\"git\", \"clone\", \"https://github.com/leejet/ComfyUI-GGUF.git\", gguf_node_dir],\n        check=True,\n    )\n\nif not os.path.exists(gguf_flag):\n    subprocess.run(\n        [\"pip\", \"install\", \"-q\", \"--target\", LIBS_DIR, \"-r\",\n         f\"{gguf_node_dir}/requirements.txt\"],\n        check=True,\n    )\n    open(gguf_flag, \"w\").close()\n\n# 4. cloudflared 下到持久化目录\ncloudflared_bin = os.path.join(BIN_DIR, \"cloudflared\")\nif not os.path.exists(cloudflared_bin):\n    tmp = cloudflared_bin + \".tmp\"\n    subprocess.run([\n        \"wget\", \"-q\",\n        \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\",\n        \"-O\", tmp,\n    ], check=True)\n    os.chmod(tmp, 0o755)\n    os.replace(tmp, cloudflared_bin)\nelse:\n    print(\"[INFO] cloudflared already present, skip.\")\n\nprint(f\"[SUCCESS] Setup done. WORK_DIR={os.getcwd()}\")\nprint(f\"  libs        -> {LIBS_DIR}\")\nprint(f\"  cloudflared -> {cloudflared_bin}\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-10-06T23:35:20.333717Z","iopub.execute_input":"2026-10-06T23:35:20.33441Z","iopub.status.idle":"2026-10-06T23:35:20.348158Z","shell.exec